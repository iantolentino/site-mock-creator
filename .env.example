# On Vercel: connect a PRIVATE Blob store through Storage, then redeploy.
# Vercel supplies BLOB_STORE_ID + OIDC credentials, or BLOB_READ_WRITE_TOKEN.
# No VERCEL_TOKEN or VERCEL_TEAM_ID is needed.
ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Local development only. This setting is ALWAYS ignored on Vercel.
LOCAL_STORAGE_DIR=.local/mockups
