# On Vercel: connect Neon (Free) through Storage, then redeploy.
# Vercel supplies DATABASE_URL automatically. Keep the default variable prefix.
# The app also recognizes POSTGRES_URL, DATABASE_URL_UNPOOLED and POSTGRES_URL_NON_POOLING.
# No VERCEL_TOKEN or VERCEL_TEAM_ID is needed.
ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Local development only. This setting is ALWAYS ignored on Vercel.
LOCAL_STORAGE_DIR=.local/mockups
